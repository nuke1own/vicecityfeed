{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.vicecityfeed.com"
        }
      ],
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/:path((?!admin(?:/|$)|_next(?:/|$)|.*\\.[^/]+$).+)",
      "has": [
        {
          "type": "host",
          "value": "admin.vicecityfeed.com"
        }
      ],
      "destination": "https://www.vicecityfeed.com/:path",
      "permanent": false
    }
  ]
}

# Public Supabase project (anon role). Set these in the Vercel project
# settings. If unset, the app falls back to the public values in
# lib/supabase-public.ts.
#
# Never put a service-role key in a NEXT_PUBLIC_ variable or commit one.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
